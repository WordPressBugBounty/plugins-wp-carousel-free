{
	"name": "wp-carousel-free",
	"private": true,
	"description": "Gutenberg block module sources for WP Carousel Free. Built to assets/ — never shipped to WordPress.org.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run build:editor && npm run build:dashboard && npm run build:frontend && npm run build:style-chunks && npm run build:divi5 && npm run copy:swiper && npm run copy:fancybox && npm run clean:rtl",
		"build:editor": "wp-scripts build blocks/blocks/index.js --output-path=assets/editor",
		"build:dashboard": "wp-scripts build blocks/admin/index.js --output-path=assets/dashboard",
		"build:frontend": "wp-scripts build blocks/blocks/frontend.js --output-path=assets/js",
		"build:style-chunks": "WPCP_STYLE_CHUNKS=1 wp-scripts build --output-path=assets/style-chunks && npm run clean:chunk-stubs",
		"build:divi5": "webpack --mode production --config webpack.divi5.config.js",
		"start": "wp-scripts start blocks/blocks/index.js --output-path=assets/editor",
		"start:admin": "wp-scripts start blocks/admin/index.js --output-path=assets/dashboard",
		"copy:swiper": "node scripts/copy-swiper.js",
		"copy:fancybox": "node scripts/copy-fancybox.js",
		"clean:rtl": "node scripts/clean-rtl.js",
		"clean:chunk-stubs": "node scripts/clean-chunk-stubs.js",
		"lint": "wp-scripts lint-js blocks/",
		"lint:fix": "wp-scripts lint-js blocks/ --fix",
		"format": "wp-scripts format blocks/",
		"format:check": "prettier --check \"blocks/**/*.{js,jsx,json,scss}\"",
		"lint:php": "phpcs --standard=phpcs.xml.dist",
		"lint:php:fix": "phpcbf --standard=phpcs.xml.dist",
		"lint:isolation": "node scripts/check-block-isolation.js",
		"lint:manifest": "node scripts/check-manifest.js",
		"port": "node scripts/port-from-pro.js",
		"lint:imports": "node scripts/check-js-imports.js",
		"test:php": "bash scripts/test-php.sh",
		"test:php:registration": "bash scripts/test-php.sh tests/php/block-registration.php",
		"test:php:projection": "bash scripts/test-php.sh tests/php/attribute-projection.php",
		"test:php:injection": "bash scripts/test-php.sh tests/php/pro-attribute-injection.php",
		"test:php:rest": "bash scripts/test-php.sh tests/php/rest-projection.php",
		"test:php:pagination-bounds": "bash scripts/test-php.sh tests/php/ajax-pagination-bounds.php",
		"test:php:query-options": "bash scripts/test-php.sh tests/php/query-options-hardening.php",
		"test:php:allowed-values": "bash scripts/test-php.sh tests/php/allowed-values.php",
		"test:php:previews": "bash scripts/test-php.sh tests/php/editor-preview-blocks.php",
		"test:php:social-gate": "bash scripts/test-php.sh tests/php/social-share-source-gate.php",
		"test:php:patterns": "bash scripts/test-php.sh tests/php/ready-patterns-tier-gate.php",
		"test:php:pattern-markup": "bash scripts/test-php.sh tests/php/ready-patterns-markup-validation.php",
		"test:php:builder-assets": "bash scripts/test-php.sh tests/php/builder-frontend-assets.php",
		"test:php:snapshot": "bash scripts/test-php.sh tests/php/attribute-snapshot.php diff",
		"test:php:snapshot:capture": "bash scripts/test-php.sh tests/php/attribute-snapshot.php capture",
		"test:php:content-runs": "bash scripts/test-php.sh tests/php/content-runs.php",
		"test:php:item-text": "bash scripts/test-php.sh tests/php/item-text-sanitizers.php",
		"test:php:image-sizes": "bash scripts/test-php.sh tests/php/image-source-sizes.php",
		"test:php:nav-arrow-size": "bash scripts/test-php.sh tests/php/nav-arrow-size-css.php",
		"test:php:baseline": "bash scripts/test-php.sh tests/php/render-baseline.php diff",
		"test:php:baseline:capture": "bash scripts/test-php.sh tests/php/render-baseline.php capture",
		"test": "jest",
		"test:unit": "jest",
		"test:unit:watch": "jest --watch",
		"test:unit:coverage": "jest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:local": "bash scripts/e2e-with-env.sh",
		"test:e2e:install": "playwright install",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "bash scripts/e2e-with-env.sh --headed",
		"test:e2e:seed": "bash scripts/e2e-with-env.sh --project=seed",
		"test:e2e:free": "bash scripts/e2e-with-env.sh --project=free",
		"test:e2e:boundary": "bash scripts/e2e-with-env.sh --project=boundary",
		"test:e2e:smoke": "bash scripts/e2e-with-env.sh --project=smoke",
		"package": "bash scripts/package.sh",
		"release": "rm -rf assets && npm run build && npm run package"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@wordpress/api-fetch": "^6.55.0",
		"@wordpress/block-editor": "^12.26.0",
		"@wordpress/blocks": "^12.35.0",
		"@wordpress/components": "^25.16.0",
		"@wordpress/icons": "^4.1.0",
		"@wordpress/scripts": "^30.24.0",
		"babel-jest": "^29.7.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"axios": "^1.19.0",
		"classnames": "^2.5.1",
		"react-hot-toast": "^2.6.0",
		"react-select": "^5.10.2",
		"swiper": "^12.1.2"
	}
}
